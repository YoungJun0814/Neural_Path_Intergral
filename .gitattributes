# Normalize line endings to LF for all text files
* text=auto eol=lf

# Python
*.py text eol=lf
*.pyi text eol=lf

# Notebooks (JSON, should be LF)
*.ipynb text eol=lf

# Config / docs
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Generated research artifacts are addressed by exact SHA-256 values recorded in
# frozen ledgers.  Preserve the producer bytes (including newline convention) so
# Windows-generated artifacts have identical hashes after a Linux checkout.
results/*.json -text
results/**/*.json -text
configs/**/*.json -text

# Shell
*.sh text eol=lf

# Binary
*.pth binary
*.pkl binary
*.npy binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.csv binary
